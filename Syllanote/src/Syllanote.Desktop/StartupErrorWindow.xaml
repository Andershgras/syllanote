<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Syllanote.Desktop.StartupErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="32"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <FontIcon
                HorizontalAlignment="Left"
                FontSize="36"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="&#xE783;" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Syllanote couldn't open your notes"
                TextWrapping="Wrap" />
            <TextBlock
                MaxWidth="620"
                HorizontalAlignment="Left"
                Text="The local database could not be prepared, so the editor was not opened. Close any other Syllanote windows, check that the folder is available and that the drive has free space, then restart Syllanote. Do not delete the database file."
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,24,0,24"
            Spacing="8">
            <TextBlock
                FontWeight="SemiBold"
                Text="Database location" />
            <TextBox
                x:Name="DatabasePathTextBox"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <Expander Header="Technical details">
                <TextBox
                    x:Name="TechnicalDetailsTextBox"
                    MaxHeight="120"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
            </Expander>
        </StackPanel>

        <Button
            Grid.Row="2"
            HorizontalAlignment="Right"
            Click="CloseButton_Click"
            Content="Close Syllanote"
            Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Window>
