<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="24"
        DataContext="{x:Bind ViewModel}"
        Loaded="RootGrid_Loaded">

        <StackPanel
            Width="350"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="12">

            <!-- Create Notebook -->
            <TextBlock
                Text="Create Notebook"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBox
                Header="Notebook name"
                PlaceholderText="e.g. Machine Learning"
                Text="{Binding NewNotebookName, Mode=TwoWay}" />

            <Button
                Content="Create Notebook"
                Command="{Binding CreateNotebookCommand}" />

            <!-- Notebook List -->
            <TextBlock
                Text="Your Notebooks"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,16,0,0" />

            <ListView
                ItemsSource="{Binding Notebooks}"
                SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}"
                SelectionChanged="NotebookListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <!-- Selected Notebook -->
            <TextBlock
                Text="{Binding SelectedNotebook.Name}"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,16,0,0" />

            <!-- Create Section -->
            <TextBox
                Header="Section name"
                PlaceholderText="e.g. Classification"
                Text="{Binding NewSectionName, Mode=TwoWay}" />

            <Button
                Content="Create Section"
                Command="{Binding CreateSectionCommand}" />

            <!-- Section List -->
            <TextBlock
                Text="Sections"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,16,0,0" />

            <ListView
                ItemsSource="{Binding Sections}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>

    </Grid>

</Window>