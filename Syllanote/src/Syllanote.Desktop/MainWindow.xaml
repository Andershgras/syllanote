<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="24"
        DataContext="{x:Bind ViewModel}"
        Loaded="RootGrid_Loaded">

        <StackPanel
            Width="350"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="12">

            <TextBlock
                Text="Create Notebook"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBox
                Header="Notebook name"
                PlaceholderText="e.g. Machine Learning"
                Text="{Binding NewNotebookName, Mode=TwoWay}" />

            <Button
                Content="Create Notebook"
                Command="{Binding CreateNotebookCommand}" />
            
            <TextBlock
                Text="Your Notebooks"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,16,0,0" />

            <ListView
                ItemsSource="{Binding Notebooks}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>

</Window>