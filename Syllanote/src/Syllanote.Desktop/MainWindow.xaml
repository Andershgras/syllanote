<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:viewModels="using:Syllanote.Desktop.ViewModels">

    <Grid
        Padding="24"
        DataContext="{x:Bind ViewModel}"
        Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" Width="360" PlaceholderText="Search pages in all notebooks" AutomationProperties.Name="Search pages" />
            <Button x:Name="SearchButton" Content="Search" Click="SearchButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="{Binding SearchMessage}" TextWrapping="Wrap" />
            <ListView x:Name="SearchResultsListView"
                      ItemsSource="{Binding SearchResults}"
                      SelectionChanged="SearchResultsListView_SelectionChanged"
                      MaxHeight="160"
                      AutomationProperties.Name="Search results">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Location}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- ==================== -->
        <!-- NOTEBOOKS + SECTIONS -->
        <!-- ==================== -->

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            RowSpacing="12"
            Margin="0,0,24,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Notebooks"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <Button
                    Grid.Column="1"
                    Content="+"
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="New notebook"
                    ToolTipService.ToolTip="New notebook"
                    Click="NewNotebookButton_Click" />
            </Grid>

            <ItemsControl
                x:Name="NotebookItemsControl"
                Grid.Row="1"
                ItemsSource="{x:Bind NotebookNavigationItems}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:NotebookNavigationItem">
                        <StackPanel>
                            <Grid MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="NotebookContextMenu_Opening">
                                        <MenuFlyoutItem
                                            Text="Move up"
                                            IsEnabled="{x:Bind CanMoveUp}"
                                            Click="MoveNotebookUpMenuItem_Click" />
                                        <MenuFlyoutItem
                                            Text="Move down"
                                            IsEnabled="{x:Bind CanMoveDown}"
                                            Click="MoveNotebookDownMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="Concept Dictionary"
                                            Click="ConceptDictionaryMenuItem_Click" />
                                        <MenuFlyoutItem
                                            Text="Rename"
                                            Click="RenameNotebookMenuItem_Click" />
                                        <MenuFlyoutItem
                                            Text="Delete"
                                            Click="DeleteNotebookButton_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Border
                                    Width="3"
                                    Height="24"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind SelectedNotebookIndicatorVisibility, Mode=OneWay}" />

                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{x:Bind ExpandCollapseGlyph, Mode=OneWay}"
                                    FontSize="14"
                                    AutomationProperties.Name="Expand or collapse notebook sections"
                                    ToolTipService.ToolTip="Expand or collapse sections"
                                    Click="NotebookExpandCollapseButton_Click" />

                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    MinHeight="36"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{x:Bind Name}"
                                    FontSize="16"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Click="NotebookNavigationButton_Click" />
                            </Grid>

                            <StackPanel Visibility="{x:Bind SectionControlsVisibility, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:NotebookNavigationItem">
                                            <Grid MinHeight="38" Margin="28,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="3"
                                                    Height="22"
                                                    CornerRadius="2"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind SelectedSectionIndicatorVisibility, Mode=OneWay}" />

                                                <Button
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    MinHeight="36"
                                                    Padding="10,4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="{x:Bind Name}"
                                                    AutomationProperties.Name="{x:Bind Name}"
                                                    Click="SectionNavigationButton_Click" />

                                                <Button
                                                    Grid.Column="2"
                                                    Content="..."
                                                    FontSize="18"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    AutomationProperties.Name="Section actions"
                                                    ToolTipService.ToolTip="Section actions"
                                                    Click="SectionActionsButton_Click">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                Text="Rename"
                                                                Click="RenameSectionMenuItem_Click" />
                                                            <MenuFlyoutItem
                                                                Text="Delete"
                                                                Click="DeleteSectionButton_Click" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Margin="42,4,0,4"
                                    Text="No sections yet. Create one to get started."
                                    TextWrapping="Wrap"
                                    Opacity="0.7"
                                    Visibility="{x:Bind EmptySectionsVisibility, Mode=OneWay}" />

                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="28,4,0,4"
                                    Padding="10,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="+  New section"
                                    AutomationProperties.Name="New section"
                                    ToolTipService.ToolTip="New section"
                                    Click="NewSectionButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                x:Name="NotebookEmptyState"
                Grid.Row="1"
                Text="No notebooks yet. Create one to get started."
                TextWrapping="Wrap"
                Opacity="0.7" />

        </Grid>


        <!-- ==================== -->
        <!-- PAGES                -->
        <!-- ==================== -->

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            RowSpacing="12"
            Margin="0,0,24,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Pages"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="NewPageButton"
                    Grid.Column="1"
                    Content="+"
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="New page"
                    ToolTipService.ToolTip="New page"
                    Click="NewPageButton_Click" />

                <Button
                    x:Name="PageActionsButton"
                    Grid.Column="2"
                    Content="..."
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Page actions"
                    ToolTipService.ToolTip="Page actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="Rename"
                                Click="RenamePageMenuItem_Click" />
                            <MenuFlyoutItem
                                Text="Delete"
                                Click="DeletePageButton_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Text="{Binding SelectedSection.Name}"
                FontSize="16"
                Opacity="0.7" />
            <ListView
                x:Name="PagesListView"
                Grid.Row="2"
                ItemsSource="{Binding Pages}"
                SelectionChanged="PageListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <TextBlock
                x:Name="PageEmptyState"
                Grid.Row="2"
                TextWrapping="Wrap"
                Opacity="0.7" />

        </Grid>

        <!-- ==================== -->
        <!-- NOTE EDITOR          -->
        <!-- ==================== -->

        <Grid x:Name="PageEditorPanel" Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="EditorPageTitle"
                Grid.Row="1"
                Text="{Binding SelectedPageTitle}"
                FontSize="28"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                IsReadOnly="True"
                IsTabStop="False"
                MinHeight="56"
                Padding="12,8"
                Margin="0,0,0,8"
                AutomationProperties.Name="Page title"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="FormattingToolbar"
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="4"
                Margin="0,0,0,8"
                Visibility="Collapsed">
                <ComboBox
                    x:Name="ParagraphStyleComboBox"
                    Width="140"
                    Height="36"
                    PlaceholderText="Normal"
                    AutomationProperties.Name="Paragraph style"
                    SelectionChanged="ParagraphStyleComboBox_SelectionChanged">
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Heading 1" />
                    <ComboBoxItem Content="Heading 2" />
                </ComboBox>
                <ToggleButton
                    x:Name="BoldButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Bold"
                    ToolTipService.ToolTip="Bold"
                    Click="BoldButton_Click">
                    <TextBlock Text="B" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ItalicButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Italic"
                    ToolTipService.ToolTip="Italic"
                    Click="ItalicButton_Click">
                    <TextBlock Text="I" FontStyle="Italic" />
                </ToggleButton>
                <ToggleButton
                    x:Name="UnderlineButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Underline"
                    ToolTipService.ToolTip="Underline"
                    Click="UnderlineButton_Click">
                    <TextBlock Text="U" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton
                    x:Name="BulletedListButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Bulleted list"
                    ToolTipService.ToolTip="Bulleted list"
                    Click="BulletedListButton_Click">
                    <TextBlock Text="•" FontSize="20" />
                </ToggleButton>
                <ToggleButton
                    x:Name="NumberedListButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Numbered list"
                    ToolTipService.ToolTip="Numbered list"
                    Click="NumberedListButton_Click">
                    <TextBlock Text="1." FontWeight="SemiBold" />
                </ToggleButton>
            </StackPanel>

            <RichEditBox
                x:Name="PageContentRichEditBox"
                Grid.Row="2"
                PlaceholderText="Start writing..."
                FontSize="14"
                SelectionChanged="PageContentRichEditBox_SelectionChanged"
                TextChanged="PageContentRichEditBox_TextChanged"
                TextWrapping="Wrap"
                MinHeight="200"
                Visibility="Collapsed">
                <primitives:FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ConceptDefinitionFlyout"
                            Placement="Bottom"
                            ShowMode="Transient">
                        <StackPanel Width="340" Spacing="8">
                            <TextBlock
                                x:Name="ConceptDefinitionNameTextBlock"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ConceptDefinitionTextBlock"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </primitives:FlyoutBase.AttachedFlyout>
            </RichEditBox>

            <TextBlock
                x:Name="EditorEmptyState"
                Grid.RowSpan="3"
                Text="Select a page to start writing."
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7" />
        </Grid>

        <!-- CONCEPT DICTIONARY -->
        <Grid x:Name="ConceptDictionaryPanel"
              Grid.Row="2"
              Grid.Column="2"
              RowSpacing="12"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Concept Dictionary"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="Back to page"
                        Click="ConceptBackButton_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding SelectedNotebook.Name}"
                       Opacity="0.7" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Button x:Name="NewConceptButton"
                            Content="New concept"
                            Click="NewConceptButton_Click" />
                    <Grid Height="140">
                        <ListView x:Name="ConceptsListView"
                                  ItemsSource="{Binding Concepts}"
                                  SelectionChanged="ConceptsListView_SelectionChanged"
                                  AutomationProperties.Name="Concepts">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ConceptEmptyState"
                                   Text="No concepts yet. Create one to get started."
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </Grid>
                    <TextBox x:Name="ConceptNameTextBox"
                             Header="Name"
                             PlaceholderText="e.g. Dependency Injection"
                             TextChanged="ConceptInput_TextChanged" />
                    <TextBox x:Name="ConceptDefinitionTextBox"
                             Header="Definition"
                             PlaceholderText="Write your own definition..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="160"
                             TextChanged="ConceptInput_TextChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveConceptButton"
                                Content="Create"
                                IsEnabled="False"
                                Click="SaveConceptButton_Click" />
                        <Button x:Name="DeleteConceptButton"
                                Content="Delete"
                                IsEnabled="False"
                                Click="DeleteConceptButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ConceptMessage" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>

</Window>
