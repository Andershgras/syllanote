<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="24"
        DataContext="{x:Bind ViewModel}"
        Loaded="RootGrid_Loaded">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ==================== -->
        <!-- NOTEBOOKS            -->
        <!-- ==================== -->

        <StackPanel
            Grid.Column="0"
            Spacing="12"
            Margin="0,0,24,0">

            <TextBlock
                Text="Notebooks"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBox
                Header="Notebook name"
                PlaceholderText="e.g. Machine Learning"
                Text="{Binding NewNotebookName, Mode=TwoWay}" />

            <Button
                Content="Create Notebook"
                Command="{Binding CreateNotebookCommand}" />

            <ListView
                ItemsSource="{Binding Notebooks}"
                SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}"
                SelectionChanged="NotebookListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>


        <!-- ==================== -->
        <!-- SECTIONS             -->
        <!-- ==================== -->

        <StackPanel
            Grid.Column="1"
            Spacing="12"
            Margin="0,0,24,0">

            <TextBlock
                Text="Sections"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBlock
                Text="{Binding SelectedNotebook.Name}"
                FontSize="16"
                Opacity="0.7" />

            <TextBox
                Header="Section name"
                PlaceholderText="e.g. Classification"
                Text="{Binding NewSectionName, Mode=TwoWay}" />

            <Button
                Content="Create Section"
                Command="{Binding CreateSectionCommand}" />

            <ListView
                ItemsSource="{Binding Sections}"
                SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                SelectionChanged="SectionListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>


        <!-- ==================== -->
        <!-- PAGES                -->
        <!-- ==================== -->

        <StackPanel
            Grid.Column="2"
            Spacing="12">

            <TextBlock
                Text="Pages"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBlock
                Text="{Binding SelectedSection.Name}"
                FontSize="16"
                Opacity="0.7" />
            <TextBox
                Header="Page title"
                PlaceholderText="e.g. Confusion Matrix"
                Text="{Binding NewPageTitle, Mode=TwoWay}" />

            <Button
                Content="Create Page"
                Command="{Binding CreatePageCommand}" />
            
            <ListView
                ItemsSource="{Binding Pages}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>

    </Grid>

</Window>