<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Syllanote.Desktop.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Grid
        x:Name="RootGrid"
        Padding="16"
        DataContext="{x:Bind ViewModel}"
        ActualThemeChanged="RootGrid_ActualThemeChanged"
        Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="NotebookColumn"
                Width="280"
                MinWidth="220"
                MaxWidth="420" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition
                x:Name="PageColumn"
                Width="240"
                MinWidth="180"
                MaxWidth="360" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition
                Width="*"
                MinWidth="360" />
        </Grid.ColumnDefinitions>

        <controls:TopBar
            x:Name="TopBar"
            Grid.Row="0"
            Grid.ColumnSpan="5"
            BackupRequested="TopBar_BackupRequested"
            RestoreRequested="TopBar_RestoreRequested"
            SearchRequested="TopBar_SearchRequested"
            SearchResultInvoked="TopBar_SearchResultInvoked" />

        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="5"
            Margin="0,12,0,0"
            Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasPageSaveError, Mode=OneWay}"
                Message="{x:Bind ViewModel.PageSaveErrorMessage, Mode=OneWay}"
                AutomationProperties.LiveSetting="Assertive"
                Severity="Error"
                Title="Changes couldn't be saved" />
            <InfoBar
                x:Name="OperationInfoBar"
                IsClosable="True"
                IsOpen="False"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="5"
            Style="{StaticResource SyllanotePanelCardStyle}" />

        <!-- ==================== -->
        <!-- NOTEBOOKS + SECTIONS -->
        <!-- ==================== -->

        <controls:NotebookSidebar
            x:Name="NotebookSidebar"
            Grid.Row="2"
            Grid.Column="0"
            NewNotebookRequested="NewNotebookButton_Click"
            NotebookExpandCollapseRequested="NotebookExpandCollapseButton_Click"
            NotebookContextMenuOpening="NotebookContextMenu_Opening"
            MoveNotebookUpRequested="MoveNotebookUpMenuItem_Click"
            MoveNotebookDownRequested="MoveNotebookDownMenuItem_Click"
            ConceptDictionaryRequested="ConceptDictionaryMenuItem_Click"
            RenameNotebookRequested="RenameNotebookMenuItem_Click"
            DeleteNotebookRequested="DeleteNotebookButton_Click"
            SectionNavigationRequested="SectionNavigationButton_Click"
            SectionContextMenuOpening="SectionContextMenu_Opening"
            MoveSectionUpRequested="MoveSectionUpMenuItem_Click"
            MoveSectionDownRequested="MoveSectionDownMenuItem_Click"
            RenameSectionRequested="RenameSectionMenuItem_Click"
            DeleteSectionRequested="DeleteSectionButton_Click"
            NewSectionRequested="NewSectionButton_Click" />


        <!-- ==================== -->
        <!-- PAGES                -->
        <!-- ==================== -->

        <controls:PageSidebar
            x:Name="PageSidebar"
            Grid.Row="2"
            Grid.Column="2"
            NewPageRequested="NewPageButton_Click"
            PageSelectionChanged="PageListView_SelectionChanged"
            PageContextMenuOpening="PageContextMenu_Opening"
            MovePageUpRequested="MovePageUpMenuItem_Click"
            MovePageDownRequested="MovePageDownMenuItem_Click"
            RenamePageRequested="RenamePageMenuItem_Click"
            DeletePageRequested="DeletePageMenuItem_Click" />

        <!-- ==================== -->
        <!-- NOTE EDITOR          -->
        <!-- ==================== -->

        <controls:EditorView
            x:Name="EditorView"
            Grid.Row="2"
            Grid.Column="4"
            ParagraphStyleSelectionChanged="ParagraphStyleComboBox_SelectionChanged"
            BoldRequested="BoldButton_Click"
            ItalicRequested="ItalicButton_Click"
            UnderlineRequested="UnderlineButton_Click"
            BulletedListRequested="BulletedListButton_Click"
            NumberedListRequested="NumberedListButton_Click"
            ContentSelectionChanged="PageContentRichEditBox_SelectionChanged"
            ContentTextChanged="PageContentRichEditBox_TextChanged" />

        <controls:ConceptDictionaryView
            x:Name="ConceptDictionaryView"
            Grid.Row="2"
            Grid.Column="4"
            Margin="16"
            Visibility="Collapsed"
            BackRequested="ConceptBackButton_Click"
            NewConceptRequested="NewConceptButton_Click"
            ConceptSelectionChanged="ConceptsListView_SelectionChanged"
            ReferenceSelectionChanged="ConceptReferencesListView_SelectionChanged"
            InputChanged="ConceptInput_TextChanged"
            SaveRequested="SaveConceptButton_Click"
            DeleteRequested="DeleteConceptButton_Click" />

        <primitives:Thumb
            Grid.Row="2"
            Grid.Column="1"
            Style="{StaticResource SyllanoteColumnSplitterStyle}"
            AutomationProperties.Name="Resize notebook panel"
            DragDelta="NotebookColumnSplitter_DragDelta"
            DragCompleted="NotebookColumnSplitter_DragCompleted" />

        <primitives:Thumb
            Grid.Row="2"
            Grid.Column="3"
            Style="{StaticResource SyllanoteColumnSplitterStyle}"
            AutomationProperties.Name="Resize page panel"
            DragDelta="PageColumnSplitter_DragDelta"
            DragCompleted="PageColumnSplitter_DragCompleted" />

    </Grid>

</Window>
