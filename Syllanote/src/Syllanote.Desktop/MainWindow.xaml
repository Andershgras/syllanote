<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Syllanote.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Grid
        Padding="24"
        DataContext="{x:Bind ViewModel}"
        Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox x:Name="SearchTextBox" Width="360" PlaceholderText="Search pages in all notebooks" AutomationProperties.Name="Search pages" />
            <Button x:Name="SearchButton" Content="Search" Click="SearchButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding SearchMessage}" TextWrapping="Wrap" />
            <ListView x:Name="SearchResultsListView"
                      ItemsSource="{Binding SearchResults}"
                      SelectionChanged="SearchResultsListView_SelectionChanged"
                      MaxHeight="160"
                      AutomationProperties.Name="Search results">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Location}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- ==================== -->
        <!-- NOTEBOOKS            -->
        <!-- ==================== -->

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            RowSpacing="12"
            Margin="0,0,24,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Notebooks"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <Button
                    Grid.Column="1"
                    Content="+"
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="New notebook"
                    ToolTipService.ToolTip="New notebook"
                    Click="NewNotebookButton_Click" />

                <Button
                    x:Name="NotebookActionsButton"
                    Grid.Column="2"
                    Content="..."
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Notebook actions"
                    ToolTipService.ToolTip="Notebook actions">
                    <Button.Flyout>
                        <MenuFlyout Opening="NotebookActionsFlyout_Opening">
                            <MenuFlyoutItem
                                x:Name="MoveNotebookUpMenuItem"
                                Text="Move up"
                                Click="MoveNotebookUpMenuItem_Click" />
                            <MenuFlyoutItem
                                x:Name="MoveNotebookDownMenuItem"
                                Text="Move down"
                                Click="MoveNotebookDownMenuItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="Concept Dictionary"
                                Click="ConceptDictionaryMenuItem_Click" />
                            <MenuFlyoutItem
                                Text="Rename"
                                Click="RenameNotebookMenuItem_Click" />
                            <MenuFlyoutItem
                                Text="Delete"
                                Click="DeleteNotebookButton_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <ListView
                x:Name="NotebookListView"
                Grid.Row="1"
                ItemsSource="{Binding Notebooks}"
                SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}"
                SelectionChanged="NotebookListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <TextBlock
                x:Name="NotebookEmptyState"
                Grid.Row="1"
                Text="No notebooks yet. Create one to get started."
                TextWrapping="Wrap"
                Opacity="0.7" />

        </Grid>


        <!-- ==================== -->
        <!-- SECTIONS             -->
        <!-- ==================== -->

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            RowSpacing="12"
            Margin="0,0,24,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Sections"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="NewSectionButton"
                    Grid.Column="1"
                    Content="+"
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="New section"
                    ToolTipService.ToolTip="New section"
                    Click="NewSectionButton_Click" />

                <Button
                    x:Name="SectionActionsButton"
                    Grid.Column="2"
                    Content="..."
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Section actions"
                    ToolTipService.ToolTip="Section actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="Rename"
                                Click="RenameSectionMenuItem_Click" />
                            <MenuFlyoutItem
                                Text="Delete"
                                Click="DeleteSectionButton_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Text="{Binding SelectedNotebook.Name}"
                FontSize="16"
                Opacity="0.7" />

            <ListView
                x:Name="SectionListView"
                Grid.Row="2"
                ItemsSource="{Binding Sections}"
                SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                SelectionChanged="SectionListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <TextBlock
                x:Name="SectionEmptyState"
                Grid.Row="2"
                TextWrapping="Wrap"
                Opacity="0.7" />

        </Grid>


        <!-- ==================== -->
        <!-- PAGES                -->
        <!-- ==================== -->

        <Grid
            Grid.Row="2"
            Grid.Column="2"
            RowSpacing="12"
            Margin="0,0,24,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Pages"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="NewPageButton"
                    Grid.Column="1"
                    Content="+"
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="New page"
                    ToolTipService.ToolTip="New page"
                    Click="NewPageButton_Click" />

                <Button
                    x:Name="PageActionsButton"
                    Grid.Column="2"
                    Content="..."
                    FontSize="18"
                    Width="32"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Page actions"
                    ToolTipService.ToolTip="Page actions">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="Rename"
                                Click="RenamePageMenuItem_Click" />
                            <MenuFlyoutItem
                                Text="Delete"
                                Click="DeletePageButton_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Text="{Binding SelectedSection.Name}"
                FontSize="16"
                Opacity="0.7" />
            <ListView
                x:Name="PagesListView"
                Grid.Row="2"
                ItemsSource="{Binding Pages}"
                SelectionChanged="PageListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="16" />
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <TextBlock
                x:Name="PageEmptyState"
                Grid.Row="2"
                TextWrapping="Wrap"
                Opacity="0.7" />

        </Grid>

        <!-- ==================== -->
        <!-- NOTE EDITOR          -->
        <!-- ==================== -->

        <Grid x:Name="PageEditorPanel" Grid.Row="2" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="EditorPageTitle"
                Text="{Binding SelectedPageTitle}"
                FontSize="28"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Margin="0,0,0,16"
                Visibility="Collapsed" />

            <RichEditBox
                x:Name="PageContentRichEditBox"
                Grid.Row="1"
                PlaceholderText="Start writing..."
                TextChanged="PageContentRichEditBox_TextChanged"
                TextWrapping="Wrap"
                MinHeight="200"
                Visibility="Collapsed">
                <primitives:FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ConceptDefinitionFlyout"
                            Placement="Bottom"
                            ShowMode="Transient">
                        <StackPanel Width="340" Spacing="8">
                            <TextBlock
                                x:Name="ConceptDefinitionNameTextBlock"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ConceptDefinitionTextBlock"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </primitives:FlyoutBase.AttachedFlyout>
            </RichEditBox>

            <TextBlock
                x:Name="EditorEmptyState"
                Grid.RowSpan="2"
                Text="Select a page to start writing."
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7" />
        </Grid>

        <!-- CONCEPT DICTIONARY -->
        <Grid x:Name="ConceptDictionaryPanel"
              Grid.Row="2"
              Grid.Column="3"
              RowSpacing="12"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Concept Dictionary"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="Back to page"
                        Click="ConceptBackButton_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding SelectedNotebook.Name}"
                       Opacity="0.7" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Button x:Name="NewConceptButton"
                            Content="New concept"
                            Click="NewConceptButton_Click" />
                    <Grid Height="140">
                        <ListView x:Name="ConceptsListView"
                                  ItemsSource="{Binding Concepts}"
                                  SelectionChanged="ConceptsListView_SelectionChanged"
                                  AutomationProperties.Name="Concepts">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ConceptEmptyState"
                                   Text="No concepts yet. Create one to get started."
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </Grid>
                    <TextBox x:Name="ConceptNameTextBox"
                             Header="Name"
                             PlaceholderText="e.g. Dependency Injection"
                             TextChanged="ConceptInput_TextChanged" />
                    <TextBox x:Name="ConceptDefinitionTextBox"
                             Header="Definition"
                             PlaceholderText="Write your own definition..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="160"
                             TextChanged="ConceptInput_TextChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveConceptButton"
                                Content="Create"
                                IsEnabled="False"
                                Click="SaveConceptButton_Click" />
                        <Button x:Name="DeleteConceptButton"
                                Content="Delete"
                                IsEnabled="False"
                                Click="DeleteConceptButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ConceptMessage" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>

</Window>
