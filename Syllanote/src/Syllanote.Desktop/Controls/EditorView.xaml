<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Syllanote.Desktop.Controls.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Border
        Padding="16"
        Style="{StaticResource SyllanoteShellPaneStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="EditorPageTitle"
                Grid.Row="0"
                Text="{Binding SelectedPageTitle}"
                FontSize="28"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                IsReadOnly="True"
                IsTabStop="False"
                MinHeight="44"
                Padding="0"
                Margin="0,0,0,12"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="Page title"
                Visibility="Collapsed" />

            <Border
                x:Name="FormattingToolbar"
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">
                    <ComboBox
                        x:Name="ParagraphStyleComboBox"
                        Width="140"
                        Height="36"
                        PlaceholderText="Normal"
                        AutomationProperties.Name="Paragraph style"
                        SelectionChanged="ParagraphStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Heading 1" />
                        <ComboBoxItem Content="Heading 2" />
                    </ComboBox>

                    <Border Style="{StaticResource SyllanoteEditorToolbarSeparatorStyle}" />

                    <ToggleButton
                        x:Name="BoldButton"
                        Style="{StaticResource SyllanoteEditorToolbarToggleButtonStyle}"
                        AutomationProperties.Name="Bold"
                        ToolTipService.ToolTip="Bold"
                        Click="BoldButton_Click">
                        <TextBlock Text="B" FontWeight="Bold" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ItalicButton"
                        Style="{StaticResource SyllanoteEditorToolbarToggleButtonStyle}"
                        AutomationProperties.Name="Italic"
                        ToolTipService.ToolTip="Italic"
                        Click="ItalicButton_Click">
                        <TextBlock Text="I" FontStyle="Italic" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="UnderlineButton"
                        Style="{StaticResource SyllanoteEditorToolbarToggleButtonStyle}"
                        AutomationProperties.Name="Underline"
                        ToolTipService.ToolTip="Underline"
                        Click="UnderlineButton_Click">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>

                    <Border Style="{StaticResource SyllanoteEditorToolbarSeparatorStyle}" />

                    <ToggleButton
                        x:Name="BulletedListButton"
                        Style="{StaticResource SyllanoteEditorToolbarToggleButtonStyle}"
                        AutomationProperties.Name="Bulleted list"
                        ToolTipService.ToolTip="Bulleted list"
                        Click="BulletedListButton_Click">
                        <FontIcon
                            Glyph="&#xE8FD;"
                            FontSize="16" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="NumberedListButton"
                        Style="{StaticResource SyllanoteEditorToolbarToggleButtonStyle}"
                        AutomationProperties.Name="Numbered list"
                        ToolTipService.ToolTip="Numbered list"
                        Click="NumberedListButton_Click">
                        <FontIcon
                            Glyph="&#xEA1C;"
                            FontSize="16" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <RichEditBox
                x:Name="PageContentRichEditBox"
                Grid.Row="2"
                PlaceholderText="Start writing..."
                FontSize="14"
                Padding="20,16"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SelectionChanged="PageContentRichEditBox_SelectionChanged"
                TextChanged="PageContentRichEditBox_TextChanged"
                TextWrapping="Wrap"
                MinHeight="200"
                Visibility="Collapsed">
                <primitives:FlyoutBase.AttachedFlyout>
                    <Flyout
                        x:Name="ConceptDefinitionFlyout"
                        Placement="Bottom"
                        ShowMode="Transient">
                        <StackPanel Width="340" Spacing="8">
                            <TextBlock
                                x:Name="ConceptDefinitionNameTextBlock"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ConceptDefinitionTextBlock"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </primitives:FlyoutBase.AttachedFlyout>
            </RichEditBox>

            <StackPanel
                x:Name="EditorEmptyState"
                Grid.RowSpan="3"
                MaxWidth="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    Glyph="&#xE70F;"
                    FontSize="32"
                    Style="{StaticResource SyllanoteEmptyStateIconStyle}" />
                <TextBlock
                    Text="No page selected"
                    FontSize="18"
                    Style="{StaticResource SyllanoteEmptyStateTitleTextStyle}" />
                <TextBlock
                    Text="Select a page from the list to start writing."
                    Style="{StaticResource SyllanoteEmptyStateDescriptionTextStyle}" />
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
