<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Syllanote.Desktop.Controls.TopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,8">
            <TextBox
                x:Name="SearchTextBox"
                Width="360"
                PlaceholderText="Search pages in all notebooks"
                AutomationProperties.Name="Search pages"
                AutomationProperties.HelpText="Press Ctrl+F to focus search and Enter to search"
                KeyDown="SearchTextBox_KeyDown">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="F"
                        Modifiers="Control"
                        Invoked="FocusSearchKeyboardAccelerator_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Button
                x:Name="SearchButton"
                Content="Search"
                Click="SearchButton_Click" />
            <ProgressRing
                x:Name="SearchProgressRing"
                Width="20"
                Height="20"
                IsActive="False"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                AutomationProperties.Name="Searching pages" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock
                Text="{Binding SearchMessage}"
                TextWrapping="Wrap" />
            <ListView
                x:Name="SearchResultsListView"
                ItemsSource="{Binding SearchResults}"
                SelectionChanged="SearchResultsListView_SelectionChanged"
                MaxHeight="160"
                AutomationProperties.Name="Search results">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock
                                Text="{Binding PageTitle}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="{Binding Location}"
                                Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </StackPanel>

</UserControl>
