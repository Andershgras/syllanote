<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Syllanote.Desktop.Controls.PageSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Pages"
                FontSize="20"
                FontWeight="SemiBold" />

            <Button
                x:Name="NewPageButton"
                Grid.Column="1"
                Content="+"
                FontSize="18"
                Width="32"
                Height="32"
                Padding="0"
                IsEnabled="False"
                AutomationProperties.Name="New page"
                ToolTipService.ToolTip="New page"
                Click="NewPageButton_Click" />
        </Grid>

        <ListView
            x:Name="PagesListView"
            Grid.Row="1"
            ItemsSource="{Binding Pages}"
            SelectionChanged="PagesListView_SelectionChanged">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="PageContextMenu_Opening">
                                <MenuFlyoutItem
                                    Text="Move up"
                                    Click="MovePageUpMenuItem_Click" />
                                <MenuFlyoutItem
                                    Text="Move down"
                                    Click="MovePageDownMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Text="Rename"
                                    Click="RenamePageMenuItem_Click" />
                                <MenuFlyoutItem
                                    Text="Delete"
                                    Click="DeletePageMenuItem_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="16" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="PageEmptyState"
            Grid.Row="1"
            TextWrapping="Wrap"
            Opacity="0.7" />
    </Grid>

</UserControl>
