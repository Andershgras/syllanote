<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Syllanote.Desktop.Controls.PageSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="12"
        Style="{StaticResource SyllanoteShellPaneStyle}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Pages"
                    FontSize="18"
                    Style="{StaticResource SyllanotePanelTitleTextStyle}" />

                <Button
                    x:Name="NewPageButton"
                    Grid.Column="1"
                    Style="{StaticResource SyllanoteHeaderIconButtonStyle}"
                    IsEnabled="False"
                    AutomationProperties.Name="New page"
                    ToolTipService.ToolTip="New page"
                    Click="NewPageButton_Click">
                    <FontIcon
                        Glyph="&#xE710;"
                        FontSize="14" />
                </Button>
            </Grid>

            <ListView
                x:Name="PagesListView"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Pages}"
                AutomationProperties.Name="Pages"
                AutomationProperties.HelpText="Use the arrow keys to choose a page. Press Shift+F10 for more actions."
                ContainerContentChanging="PagesListView_ContainerContentChanging"
                SelectionChanged="PagesListView_SelectionChanged">

                <ListView.Resources>
                    <StaticResource
                        x:Key="ListViewItemSelectionIndicatorBrush"
                        ResourceKey="AccentFillColorDefaultBrush" />
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">True</x:Boolean>
                    <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">2</CornerRadius>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="38" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <Setter Property="FocusVisualMargin" Value="-1" />
                        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="PageContextMenu_Opening">
                                    <MenuFlyoutItem
                                        Text="Move up"
                                        Click="MovePageUpMenuItem_Click" />
                                    <MenuFlyoutItem
                                        Text="Move down"
                                        Click="MovePageDownMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Text="Rename"
                                        Click="RenamePageMenuItem_Click" />
                                    <MenuFlyoutItem
                                        Text="Delete"
                                        Click="DeletePageMenuItem_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="14"
                                Opacity="0.7"
                                AutomationProperties.AccessibilityView="Raw"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Text="{Binding Title}"
                                FontSize="14"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="PageEmptyState"
                Grid.Row="1"
                MaxWidth="190"
                Margin="12,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Spacing="8">
                <FontIcon
                    x:Name="PageEmptyStateIcon"
                    Glyph="&#xE8B7;"
                    FontSize="28"
                    Style="{StaticResource SyllanoteEmptyStateIconStyle}" />
                <TextBlock
                    x:Name="PageEmptyStateTitle"
                    Text="No section selected"
                    Style="{StaticResource SyllanoteEmptyStateTitleTextStyle}" />
                <TextBlock
                    x:Name="PageEmptyStateDescription"
                    Text="Select a section to see its pages."
                    Style="{StaticResource SyllanoteEmptyStateDescriptionTextStyle}" />
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
